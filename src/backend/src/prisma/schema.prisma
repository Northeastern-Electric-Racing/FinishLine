  deniedMembers              User[]          @relation(name: "deniedEventAttendee")
  teams                      Team[]          @relation(name: "affiliatedTeam")
  teamType                   Team_Type?      @relation(fields: [teamTypeId], references: [teamTypeId])
  teamTypeId                 String?
  location                   String?
  zoomLink                   String?
  shops                      Shop[]
  machinery                  Machinery[]
  workPackages               Work_Package[]
  documentIds                String[]
  status                     Event_Status
  questionDocument           String?
  description                String?
