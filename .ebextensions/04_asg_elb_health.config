# Have the auto scaling group use the load balancer's health check instead of only EC2 status checks,
# so an instance that stops answering /health (e.g. frozen by a memory spike) is terminated and replaced
# automatically. The grace period gives a new instance time to boot and start the app before it is judged.
Resources:
  AWSEBAutoScalingGroup:
    Type: "AWS::AutoScaling::AutoScalingGroup"
    Properties:
      HealthCheckType: ELB
      HealthCheckGracePeriod: 300
